# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust values. `.env` is never committed.
# ---------------------------------------------------------------------------

# Core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Production uses PostgreSQL. Provide a DATABASE_URL and the project will use it.
# If DATABASE_URL is omitted the project falls back to a local SQLite file so it
# runs out of the box for development.
DATABASE_URL=postgres://barber:barber@localhost:5432/barber

# Email
# Development defaults to the console backend (emails print to the terminal).
# For real SMTP set these and switch DJANGO_SETTINGS_MODULE to config.settings.production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nearby <no-reply@nearby.local>

# Media / static
MEDIA_URL=/media/
STATIC_URL=/static/

# Maps (public defaults — no API key required for OpenStreetMap tiles)
MAP_DEFAULT_LAT=40.4093
MAP_DEFAULT_LNG=49.8671
MAP_DEFAULT_ZOOM=12
NEARBY_DEFAULT_RADIUS_KM=10

# CORS (comma separated origins; only needed if the API is consumed cross-origin)
CORS_ALLOWED_ORIGINS=
